
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Thử thách lịch sử 1930–1939</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      background: #f5f3ec;
      font-family: Arial, sans-serif;
      color: #263746;
    }
    .app {
      width: min(700px, 90%);
      background: white;
      padding: 30px;
      border-radius: 1px;
      box-shadow: 0 10px 35px #102f4d20;
    }
    h1 { color: #102f4d; }
    button {
      width: 100%;
      padding: 14px;
      margin: 7px 0;
      border: 0;
      border-radius: 1px;
      background: #eaf0f3;
      cursor: pointer;
      font-size: 16px;
      text-align: left;
    }
    button:hover { background: #d9edf5; }
    .primary {
      background: #1675ad;
      color: white;
      text-align: center;
    }
    .hidden { display: none; }
    #feedback {
      padding: 12px;
      background: #eaf7f0;
      border-radius: 1px;
      margin: 12px 0;
    }



    


    /* Khu vực hiển thị meme */
#meme-layer {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  pointer-events: none;
  z-index: 9999;
  overflow: hidden;
}

.meme-image {
  width: min(300px, 75vw);
  max-height: 65vh;
  object-fit: contain;
  border-radius: 16px;
  animation: memeEffect 1s ease-out forwards;
}

@keyframes memeEffect {
  0% {
    transform: scale(0.3);
    opacity: 1;
  }
  100% {
    transform: scale(1.8);
    opacity: 0;
  }
}


  </style>
</head>
<body>
<div class="app">
  <section id="start">
    <h1>Giải mã lịch sử 1930–1939</h1>
    <p>10 câu hỏi củng cố kiến thức Bài 7.</p>
    <button class="primary" onclick="startGame()">Bắt đầu</button>
  </section>

  <section id="game" class="hidden">
    <p id="counter"></p>
    <h2 id="question"></h2>
    <div id="answers"></div>
    <div id="feedback" class="hidden"></div>
    <button id="next" class="primary hidden" onclick="nextQuestion()">Câu tiếp theo</button>
  </section>

  <section id="result" class="hidden">
    <h1>Hoàn thành!</h1>
    <h2 id="score"></h2>
    <p id="message"></p>
    <button class="primary" onclick="startGame()">Chơi lại</button>
  </section>
</div>

<div id="meme-layer"></div>

<script>


const correctMemes = [
  "https://theselfishmeme.co.uk/wp-content/uploads/2025/10/hai-huoc-meme-hai-hot-24.webp",
  "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ2I15NIIYtEtvE0DL6EkzZ5LZWBHwLsSteDgIQCh6T2grCdq5Vc-k93g0&s=10",
  "https://i.ytimg.com/vi/8lCpdAQFxdE/maxresdefault.jpg"
];


const wrongMemes = [
  "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTvCla6z-zYVoZqo7pR49qP6IX6k_VVFp7ftzP-jMH2YA&s",
  "https://theselfishmeme.co.uk/wp-content/uploads/2025/10/hai-huoc-meme-hai-hot-1.webp",
  "https://theselfishmeme.co.uk/wp-content/uploads/2025/10/hai-huoc-meme-hai-hot-23.webp"
];

function showMeme(isCorrect) {
  let memeList = isCorrect ? correctMemes : wrongMemes;

  let randomIndex = Math.floor(Math.random() * memeList.length);

  let image = document.createElement("img");
  image.src = memeList[randomIndex];
  image.className = "meme-image";

  let layer = document.getElementById("meme-layer");
  layer.appendChild(image);

  image.onerror = function() {
    image.remove();
    console.log("Không tải được ảnh meme!");
  };

  image.addEventListener("animationend", function() {
    image.remove();
  });
}


const questions = [
  {
    q: "Khủng hoảng kinh tế thế giới bắt đầu năm nào?",
    a: ["1925", "1929", "1933", "1939"],
    correct: 1,
    explain: "Khủng hoảng kinh tế thế giới bắt đầu năm 1929."
  },
  {
    q: "Hai lực lượng đông đảo trong phong trào 1930–1931?",
    a: ["Công nhân và nông dân", "Địa chủ", "Thương nhân", "Binh lính"],
    correct: 0,
    explain: "Công nhân và nông dân là lực lượng chủ yếu."
  },
  {
    q: "Phong trào 1930–1931 đạt đỉnh cao ở đâu?",
    a: ["Hà Nội", "Sài Gòn", "Nghệ An – Hà Tĩnh", "Huế"],
    correct: 2,
    explain: "Đỉnh cao là Xô viết Nghệ – Tĩnh."
  },
  {
    q: "Xô viết Nghệ – Tĩnh thuộc giai đoạn nào?",
    a: ["1918–1920", "1925–1929", "1930–1931", "1936–1939"],
    correct: 2,
    explain: "Xô viết Nghệ – Tĩnh diễn ra trong cao trào 1930–1931."
  },
  {
    q: "Ý nghĩa của phong trào 1930–1931?",
    a: [
      "Việt Nam độc lập ngay lập tức",
      "Khẳng định vai trò lãnh đạo của Đảng",
      "Chấm dứt chiến tranh",
      "Thành lập chính quyền toàn quốc"
    ],
    correct: 1,
    explain: "Phong trào khẳng định năng lực lãnh đạo của Đảng."
  },
  {
    q: "Mặt trận Nhân dân lên nắm quyền ở Pháp năm nào?",
    a: ["1930", "1932", "1936", "1939"],
    correct: 2,
    explain: "Sự kiện diễn ra năm 1936."
  },
  {
    q: "Mục tiêu trước mắt của phong trào 1936–1939?",
    a: [
      "Đòi tự do, dân chủ, cơm áo và hòa bình",
      "Chỉ đòi ruộng đất",
      "Đánh đuổi quân Nhật",
      "Xây dựng chính quyền Xô viết"
    ],
    correct: 0,
    explain: "Đây là những yêu sách dân sinh, dân chủ quan trọng."
  },
  {
    q: "Hình thức đấu tranh phổ biến giai đoạn 1936–1939?",
    a: [
      "Chỉ đấu tranh vũ trang",
      "Mít tinh, hội họp, báo chí, kiến nghị",
      "Chỉ hoạt động bí mật",
      "Không đấu tranh"
    ],
    correct: 1,
    explain: "Phong trào sử dụng nhiều hình thức công khai, hợp pháp và nửa hợp pháp."
  },
  {
    q: "Cuộc mít tinh ngày 1/5/1938 diễn ra ở đâu?",
    a: [
      "Quảng trường Ba Đình",
      "Khu Đấu Xảo, Hà Nội",
      "Bến Nhà Rồng",
      "Nghệ An"
    ],
    correct: 1,
    explain: "Sự kiện diễn ra tại khu Đấu Xảo, Hà Nội."
  },
  {
    q: "Điểm khác biệt nổi bật giữa hai phong trào?",
    a: [
      "Cả hai chỉ đấu tranh bằng báo chí",
      "1930–1931 đấu tranh quyết liệt; 1936–1939 đẩy mạnh hoạt động công khai",
      "1936–1939 không có quần chúng",
      "1930–1931 chỉ hoạt động nghị trường"
    ],
    correct: 1,
    explain: "Hai phong trào có hình thức đấu tranh phù hợp với hoàn cảnh lịch sử khác nhau."
  }
];

let index = 0;
let points = 0;
let answered = false;

function show(id) {
  document.querySelectorAll("section").forEach(s => {
    s.classList.add("hidden");
  });
  document.getElementById(id).classList.remove("hidden");
}

function startGame() {
  index = 0;
  points = 0;
  show("game");
  renderQuestion();
}

function renderQuestion() {
  answered = false;
  let q = questions[index];

  document.getElementById("counter").textContent =
    "Câu " + (index + 1) + " / " + questions.length;

  document.getElementById("question").textContent = q.q;

  let answers = document.getElementById("answers");
  answers.innerHTML = "";

  q.a.forEach((answer, i) => {
    let btn = document.createElement("button");
    btn.textContent = String.fromCharCode(65 + i) + ". " + answer;
    btn.onclick = () => chooseAnswer(i);
    answers.appendChild(btn);
  });

  document.getElementById("feedback").classList.add("hidden");
  document.getElementById("next").classList.add("hidden");
}

function chooseAnswer(choice) {
  if (answered) return;
  answered = true;

  showMeme(choice === questions[index].correct);

  let q = questions[index];
  let buttons = document.querySelectorAll("#answers button");

  buttons.forEach((btn, i) => {
    btn.disabled = true;
    if (i === q.correct) {
      btn.style.background = "#c9efdc";
    } else if (i === choice) {
      btn.style.background = "#ffdada";
    }
  });

  let feedback = document.getElementById("feedback");
  feedback.classList.remove("hidden");

  if (choice === q.correct) {
    points++;
    feedback.textContent = "Chính xác! " + q.explain;
  } else {
    feedback.textContent = "Chưa đúng! " + q.explain;
  }

  document.getElementById("next").classList.remove("hidden");
  document.getElementById("next").textContent =
    index === questions.length - 1 ? "Xem kết quả" : "Câu tiếp theo";
}

function nextQuestion() {
  if (!answered) return;

  index++;

  if (index < questions.length) {
    renderQuestion();
  } else {
    showResult();
  }
}

function showResult() {
  show("result");
  document.getElementById("score").textContent =
    points + " / " + questions.length + " điểm";

  let message = "Hãy ôn tập thêm nhé!";
  if (points === 10) message = "Xuất sắc! Bạn đã nắm vững kiến thức!";
  else if (points >= 8) message = "Rất tốt! Gần như hoàn hảo!";
  else if (points >= 5) message = "Khá ổn! Cố gắng thêm nhé!";

  document.getElementById("message").textContent = message;
}
</script>
</body>
</html>
